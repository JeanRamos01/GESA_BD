
DROP VIEW  IF EXISTS v_productos       CASCADE;
DROP TABLE IF EXISTS detalle_compra    CASCADE;
DROP TABLE IF EXISTS compras           CASCADE;
DROP TABLE IF EXISTS pagos             CASCADE;
DROP TABLE IF EXISTS detalle_venta     CASCADE;
DROP TABLE IF EXISTS ventas            CASCADE;
DROP TABLE IF EXISTS producto_sucursal CASCADE;
DROP TABLE IF EXISTS inventario        CASCADE;
DROP TABLE IF EXISTS usuarios          CASCADE;
DROP TABLE IF EXISTS empleados         CASCADE;
DROP TABLE IF EXISTS clientes          CASCADE;
DROP TABLE IF EXISTS productos         CASCADE;
DROP TABLE IF EXISTS categorias        CASCADE;
DROP TABLE IF EXISTS metodo_pago       CASCADE;
DROP TABLE IF EXISTS sucursales        CASCADE;
DROP TABLE IF EXISTS proveedores       CASCADE;



CREATE TABLE categorias (
    id_categoria  SERIAL PRIMARY KEY,
    nombre        VARCHAR(50) UNIQUE NOT NULL
);

CREATE TABLE productos (
    id_producto            SERIAL PRIMARY KEY,
    codigo_producto        BIGINT UNIQUE,
    descripcion_producto   TEXT NOT NULL,
    precio                 DECIMAL(10,2),
    id_categoria           INT REFERENCES categorias(id_categoria),
    nombre_local           VARCHAR(100) DEFAULT 'GESA',
    tipo_producto          VARCHAR(50),
    estado_nivel_compania  VARCHAR(50)
);

CREATE TABLE inventario (
    id_producto  INT PRIMARY KEY REFERENCES productos(id_producto),
    stock        INT NOT NULL DEFAULT 0
);

CREATE TABLE empleados (
    id_empleado      SERIAL PRIMARY KEY,
    dni              CHAR(8) UNIQUE NOT NULL CHECK (dni ~ '^[0-9]{8}$'),
    nombre           VARCHAR(50) NOT NULL,
    apellido         VARCHAR(50) NOT NULL,
    fecha_nacimiento DATE,
    cargo            VARCHAR(50)
);

CREATE TABLE usuarios (
    id_usuario     SERIAL PRIMARY KEY,
    username       VARCHAR(50) UNIQUE NOT NULL,
    password_hash  VARCHAR(255) NOT NULL,
    id_empleado    INT REFERENCES empleados(id_empleado) ON DELETE SET NULL,
    rol            VARCHAR(20) NOT NULL CHECK (rol IN ('admin', 'empleado'))
);

CREATE TABLE proveedores (
    id_proveedor  SERIAL PRIMARY KEY,
    nombre        VARCHAR(100),
    telefono      VARCHAR(15)
);

CREATE TABLE metodo_pago (
    id_metodo  SERIAL PRIMARY KEY,
    tipo       VARCHAR(30)
);

CREATE TABLE sucursales (
    id_sucursal  SERIAL PRIMARY KEY,
    nombre       VARCHAR(100),
    direccion    TEXT
);

CREATE TABLE producto_sucursal (
    id_ps        SERIAL PRIMARY KEY,
    id_producto  INT REFERENCES productos(id_producto),
    id_sucursal  INT REFERENCES sucursales(id_sucursal),
    stock        INT NOT NULL
);

CREATE TABLE clientes (
    id_cliente  SERIAL PRIMARY KEY,
    nombre      VARCHAR(50),
    apellido    VARCHAR(50),
    telefono    VARCHAR(15)
);

CREATE TABLE ventas (
    id_venta    SERIAL PRIMARY KEY,
    id_cliente  INT REFERENCES clientes(id_cliente),
    id_empleado INT REFERENCES empleados(id_empleado),
    fecha       DATE DEFAULT CURRENT_DATE
);

CREATE TABLE detalle_venta (
    id_detalle      SERIAL PRIMARY KEY,
    id_venta        INT REFERENCES ventas(id_venta),
    id_producto     INT REFERENCES productos(id_producto),
    cantidad        INT NOT NULL,
    precio_unitario DECIMAL(10,2) NOT NULL
);

CREATE TABLE pagos (
    id_pago    SERIAL PRIMARY KEY,
    id_venta   INT REFERENCES ventas(id_venta),
    id_metodo  INT REFERENCES metodo_pago(id_metodo),
    monto      DECIMAL(10,2) NOT NULL
);

CREATE TABLE compras (
    id_compra    SERIAL PRIMARY KEY,
    id_proveedor INT REFERENCES proveedores(id_proveedor),
    id_empleado  INT REFERENCES empleados(id_empleado),
    fecha        DATE DEFAULT CURRENT_DATE
);

CREATE TABLE detalle_compra (
    id_detalle     SERIAL PRIMARY KEY,
    id_compra      INT REFERENCES compras(id_compra),
    id_producto    INT REFERENCES productos(id_producto),
    cantidad       INT NOT NULL,
    costo_unitario DECIMAL(10,2) NOT NULL
);


CREATE OR REPLACE VIEW v_productos AS
SELECT
    p.id_producto,
    p.codigo_producto,
    p.descripcion_producto,
    c.nombre               AS categoria,
    p.precio,
    COALESCE(i.stock, 0)   AS stock,
    p.nombre_local,
    p.tipo_producto,
    p.estado_nivel_compania
FROM  productos  p
LEFT JOIN categorias c ON c.id_categoria = p.id_categoria
LEFT JOIN inventario i ON i.id_producto  = p.id_producto;

CREATE OR REPLACE VIEW v_detalle_ventas AS
SELECT
    v.id_venta,
    v.fecha,
    cl.nombre || ' ' || cl.apellido   AS cliente,
    e.nombre  || ' ' || e.apellido    AS empleado,
    p.descripcion_producto             AS producto,
    cat.nombre                         AS categoria,
    dv.cantidad,
    dv.precio_unitario,
    (dv.cantidad * dv.precio_unitario) AS subtotal
FROM  ventas v
JOIN  clientes    cl  ON cl.id_cliente  = v.id_cliente
JOIN  empleados   e   ON e.id_empleado  = v.id_empleado
JOIN  detalle_venta dv ON dv.id_venta   = v.id_venta
JOIN  productos   p   ON p.id_producto  = dv.id_producto
LEFT JOIN categorias cat ON cat.id_categoria = p.id_categoria;



